{
  "name": "db-perso",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sync": "node scripts/sync.mjs",
    "sync:beta": "node scripts/sync.mjs --channel dofus3beta",
    "sync-dofusdb": "node scripts/sync-dofusdb.mjs",
    "build-data": "node scripts/build-data.mjs",
    "data": "npm run sync:beta && npm run build-data"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
